<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Back-office only. Section 8 keeps raw refusal detail off the portal:
         limits, assortment names and integration text are staff-facing. -->
    <record id="view_dms_portal_exception_list" model="ir.ui.view">
        <field name="name">dms.portal.exception.list</field>
        <field name="model">dms.portal.exception</field>
        <field name="arch" type="xml">
            <list>
                <field name="create_date"/>
                <field name="outlet_id"/>
                <field name="user_id"/>
                <field name="kind"/>
                <field name="detail"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_dms_portal_entitlement_list" model="ir.ui.view">
        <field name="name">dms.portal.entitlement.list</field>
        <field name="model">dms.portal.entitlement</field>
        <field name="arch" type="xml">
            <list>
                <field name="user_id"/>
                <field name="partner_id"/>
                <field name="scope"/>
                <field name="source"/>
                <field name="requested_by_id"/>
                <field name="approved_by_id"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_dms_outlet_qr_list" model="ir.ui.view">
        <field name="name">dms.outlet.qr.list</field>
        <field name="model">dms.outlet.qr</field>
        <field name="arch" type="xml">
            <list>
                <field name="outlet_id"/>
                <field name="issued_by_id"/>
                <field name="create_date"/>
                <field name="revoke_date"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="action_dms_portal_exception" model="ir.actions.act_window">
        <field name="name">Portal Exceptions</field>
        <field name="res_model">dms.portal.exception</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_dms_portal_entitlement" model="ir.actions.act_window">
        <field name="name">Portal Entitlements</field>
        <field name="res_model">dms.portal.entitlement</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_dms_outlet_qr" model="ir.actions.act_window">
        <field name="name">Outlet QR Codes</field>
        <field name="res_model">dms.outlet.qr</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Under one of the nine (see the note in `dms_omnichannel`), not a
         tenth beside them. "To chuc, Bao cao va Cau hinh" holds the
         entitlement register and the QR codes; the exception queue is
         operational but splitting one small addon across three sections
         costs more navigation than it saves. -->
    <menuitem id="menu_dms_portal_root" name="B2B Portal"
              parent="dms.menu_dms_ia_config" sequence="82"/>
    <menuitem id="menu_dms_portal_entitlement" name="Entitlements"
              parent="menu_dms_portal_root"
              action="action_dms_portal_entitlement" sequence="10"/>
    <menuitem id="menu_dms_portal_exception" name="Exceptions"
              parent="menu_dms_portal_root"
              action="action_dms_portal_exception" sequence="20"/>
    <menuitem id="menu_dms_outlet_qr" name="Outlet QR Codes"
              parent="menu_dms_portal_root"
              action="action_dms_outlet_qr" sequence="30"/>

</odoo>
