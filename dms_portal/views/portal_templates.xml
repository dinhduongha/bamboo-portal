<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="portal_home" name="DMS Portal">
        <t t-call="portal.portal_layout">
            <h3>Self-service</h3>
            <t t-if="not outlets">
                <p>This account has no approved entitlement yet. A request has
                   to be approved before any data is visible.</p>
            </t>
            <ul t-if="outlets">
                <li t-foreach="outlets" t-as="outlet">
                    <a t-attf-href="/my/dms/catalog?outlet_id=#{outlet.id}"
                       t-esc="outlet.display_name"/>
                </li>
            </ul>
            <p><a href="/my/dms/orders">Orders</a></p>
        </t>
    </template>

    <template id="portal_catalog" name="DMS Portal Catalog">
        <t t-call="portal.portal_layout">
            <h3>Catalog</h3>
            <t t-if="not rows">
                <p>Nothing listed for this outlet.</p>
            </t>
            <div class="table-responsive" t-if="rows">
                <table class="table">
                    <thead>
                        <tr><th>Product</th><th class="text-end">Price</th></tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="rows" t-as="row">
                            <td t-esc="row['name']"/>
                            <td class="text-end" t-esc="row['price_unit']"/>
                        </tr>
                    </tbody>
                </table>
            </div>
        </t>
    </template>

    <template id="portal_orders" name="DMS Portal Orders">
        <t t-call="portal.portal_layout">
            <h3>Orders</h3>
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr><th>Reference</th><th>Outlet</th><th>Status</th></tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="orders" t-as="order">
                            <td>
                                <a t-attf-href="/my/dms/order/#{order.id}"
                                   t-esc="order.name"/>
                            </td>
                            <td t-esc="order.partner_id.display_name"/>
                            <td t-esc="order.dms_approval_state"/>
                        </tr>
                    </tbody>
                </table>
            </div>
        </t>
    </template>

    <template id="portal_order" name="DMS Portal Order">
        <t t-call="portal.portal_layout">
            <h3 t-esc="order.name"/>
            <!-- Section 7 wants these states named, not inferred from a
                 blank screen: price changed, credit hold, backorder,
                 failed payment. -->
            <p>Status: <span t-esc="order.dms_approval_state"/></p>
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr><th>Product</th><th class="text-end">Qty</th></tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="order.order_line" t-as="line">
                            <td t-esc="line.product_id.display_name"/>
                            <td class="text-end" t-esc="line.product_uom_qty"/>
                        </tr>
                    </tbody>
                </table>
            </div>
        </t>
    </template>

</odoo>
