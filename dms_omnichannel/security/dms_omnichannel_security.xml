<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- An ACL row with no record rule is unrestricted for that group;
             `dms`'s TestRuleMatrixInvariants enforces both the existence of a
             rule and the company predicate in it. -->
        <record id="rule_dms_channel_account_company" model="ir.rule">
            <field name="name">Channel account (assignment)</field>
            <field name="model_id" ref="model_dms_channel_account"/>
            <field name="groups" eval="[(4, ref('dms.group_dms_sale_admin')), (4, ref('dms.group_dms_sale_manager'))]"/>
            <field name="domain_force">[('company_id', 'in', user._dms_assigned_company_ids('admin').ids)]</field>
        </record>

        <record id="rule_dms_channel_identity_company" model="ir.rule">
            <field name="name">Channel identity (assignment)</field>
            <field name="model_id" ref="model_dms_channel_identity"/>
            <field name="groups" eval="[(4, ref('dms.group_dms_sale_admin'))]"/>
            <field name="domain_force">[('company_id', 'in', user._dms_assigned_company_ids('admin').ids)]</field>
        </record>

        <record id="rule_dms_channel_order_company" model="ir.rule">
            <field name="name">Channel order (assignment)</field>
            <field name="model_id" ref="model_dms_channel_order"/>
            <field name="groups" eval="[(4, ref('dms.group_dms_sale_admin'))]"/>
            <field name="domain_force">[('company_id', 'in', user._dms_assigned_company_ids('admin').ids)]</field>
        </record>


        <record id="rule_dms_channel_conversation_company" model="ir.rule">
            <field name="name">Channel conversation (assignment)</field>
            <field name="model_id" ref="model_dms_channel_conversation"/>
            <field name="groups" eval="[(4, ref('dms.group_dms_sale_admin'))]"/>
            <field name="domain_force">[('company_id', 'in', user._dms_assigned_company_ids('admin').ids)]</field>
        </record>

    </data>
</odoo>
